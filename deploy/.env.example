# Configuração para Deploy Completo
# Copie este arquivo para .env e preencha com suas credenciais

# Portas
WEB_PORT=8080

# Segurança (MUDAR EM PRODUÇÃO!)
INTERNAL_SHARED_SECRET=your-secret-key-here-change-me
POSTGRES_PASSWORD=your-postgres-password-here
B2B_JWT_SECRET=your-b2b-jwt-secret-here
PANEL_JWT_SECRET=your-panel-jwt-secret-here

# URL base do WMS (para links do painel)
WMS_BASE_URL=http://your-server-ip:8080
COOKIE_SECURE=false

# Logs
LOG_LEVEL=info

# Credenciais SAP Business One
SAP_B1_BASE_URL=https://seu-servidor-sap.com:50000
SAP_B1_COMPANY_DB=SUA_EMPRESA_DB
SAP_B1_USERNAME=seu_usuario
SAP_B1_PASSWORD=sua_senha

# Configurações SAP opcionais
SAP_B1_TIMEOUT_MS=120000
SAP_B1_MAX_ATTEMPTS=3
SAP_B1_MAX_CONCURRENT=4
SAP_B1_MAX_RPS=5

# RD Station — repassadas ao container painel (BI Marketing & CRM, Cliente 360)
# Obter tokens em developers.rdstation.com (OAuth CRM v2 / API Marketing).
# RD_STATION_CRM_ACCESS_TOKEN=
# RD_STATION_MARKETING_ACCESS_TOKEN=
