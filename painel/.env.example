# Banco de dados PostgreSQL
DATABASE_URL=postgresql://wms:CHANGE_ME@localhost:5432/wms

# Secret para tokens JWT do painel (troque em produção!)
PANEL_JWT_SECRET=painel-secret-change-me-in-production

# Porta do app (padrão 3003 para dev local)
PORT=3003

# RD Station — o painel usa só estes Bearer (obtidos após OAuth: code → POST /oauth2/token).
# Guia: https://developers.rdstation.com/reference/crm-v2-authentication
# RD_STATION_CRM_ACCESS_TOKEN=
# RD_STATION_MARKETING_ACCESS_TOKEN=
#
# Apps no App Publisher (nomes sugeridos: GSN WMS - CRM / GSN WMS - Marketing) — NÃO vão no runtime
# se só tiveres client_id/secret; servem para gerar o access_token. Guarda fora do git.
# RD_STATION_CRM_CLIENT_ID=dde1e214-feab-4921-9774-3718bdac803c
# RD_STATION_CRM_CLIENT_SECRET=ebecc9e80f9b49e490f0bd301ee8b399
# RD_STATION_CRM_REDIRECT_URI=https://painel.garrafariaserranegra.com.br/api/webhooks/rd-station/crm
# RD_STATION_MARKETING_CLIENT_ID=bd02d48a-9ed8-4dec-8385-3556f2867c02
# RD_STATION_MARKETING_CLIENT_SECRET=e201389c36914de0a7f101070f530825
# RD_STATION_MARKETING_REDIRECT_URI=https://painel.garrafariaserranegra.com.br/api/webhooks/rd-station/marketing
