# ============================================
# WMS GATEWAY - Environment Variables Example
# ============================================
# Copie este arquivo para .env e ajuste os valores

# ============================================
# GATEWAY
# ============================================
GATEWAY_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=wms-gateway

# ============================================
# WMS CORE API
# ============================================
CORE_BASE_URL=http://localhost:8000

# ============================================
# SAP B1 INTEGRATION
# ============================================
# Modo: mock (desenvolvimento) ou production
SAP_MODE=mock

# Credenciais SAP (apenas em production)
SAP_BASE_URL=https://seu-sap-server.com:50000
SAP_USERNAME=seu-usuario-sap
SAP_PASSWORD=sua-senha-sap
SAP_COMPANY_DB=YOUR_COMPANY_DB

# Timeout e retry
SAP_TIMEOUT_MS=30000
SAP_MAX_RETRIES=3

# ============================================
# SEGURANÇA
# ============================================
# Secret compartilhado para endpoints internos
INTERNAL_SHARED_SECRET=dev-internal-secret

# Em produção, use secret forte
# INTERNAL_SHARED_SECRET=$(openssl rand -base64 32)

# ============================================
# RD STATION MARKETING (captura de leads B2B)
# ============================================
# API Token para conversões (obrigatório para capturar o lead no cadastro).
# Enviado como query param ?api_key= (sem Bearer).
RD_STATION_API_TOKEN=
# Access Token OAuth (opcional): aplica a tag de origem ao contato via Bearer.
RD_STATION_MARKETING_ACCESS_TOKEN=
# Identificador da conversão (opcional; padrão: "Cadastro Portal B2B").
# RD_STATION_CONVERSION_IDENTIFIER=Cadastro Portal B2B

# ============================================
# SEO — IA (OpenAI) + Ranqueamento (Google Search Console)
# ============================================
# IA de SEO (OpenAI/GPT). Sem a key, os endpoints /seo/suggest respondem 503
# ("configure OPENAI_API_KEY") e a UI mostra o estado desabilitado.
OPENAI_API_KEY=
# Modelo GPT (padrão gpt-4o-mini). Configurável.
OPENAI_MODEL=gpt-4o-mini
# (Opcional) endpoint alternativo compatível com a API da OpenAI.
# OPENAI_BASE_URL=

# Google Search Console — ranqueamento REAL sobre o site PÚBLICO.
# Property do GSC: use "sc-domain:gsnonline.com.br" (Domain property) ou o
# prefixo de URL, ex. "https://www.gsnonline.com.br/".
GSC_SITE_URL=
# Credenciais da service account: cole o JSON inteiro em GOOGLE_SERVICE_ACCOUNT_JSON
# OU aponte GOOGLE_APPLICATION_CREDENTIALS para o caminho do arquivo .json.
# A service account precisa ser adicionada como usuário da property no GSC.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Janela (dias) das métricas do GSC (padrão 28).
GSC_WINDOW_DAYS=28

# Bases públicas para mapear cada produto à sua URL pública (casamento com o GSC).
PUBLIC_STORE_GSN_BASE=https://www.gsnonline.com.br
PUBLIC_STORE_WOO_BASE=https://garrafariaserranegra.com.br
PUBLIC_STORE_WOO_PRODUCT_PATH=produto

# ============================================
# POLLING (Quando ativar)
# ============================================
# SAP_POLLING_ENABLED=true
# SAP_POLLING_INTERVAL_ORDERS=300000   # 5 min
# SAP_POLLING_INTERVAL_INVENTORY=1800000  # 30 min
# SAP_POLLING_INTERVAL_CATALOG=86400000   # 1 dia
